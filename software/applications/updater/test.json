// minimal, required
{
  "name": "my-first-vm",
  "cores": 10,
  "mem": 40,
  "provider_config": "/tmp/provider_config_4"
}

// Full
{
  "name": "my-first-vm",
  "enabled": true,
  "cores": 10,
  "mem": 40,
  "gpu": "none",  // "all", "none", "2b:00.0"(e.g.)
  "state_disk_path": "<cache>/<name>_state_disk.qcow2",
  "state_disk_size": 500,
  "provider_config_disk_path": "<cache>/<name>_provider_config.img",
  "cache": "$(pwd)",
  "provider_config": "/tmp/provider_config_4",
  "mac_address": "52:54:00:12:34:56",
  "ip_address": "0.0.0.0",
  "ssh_port": 2222,
  "http_port": 0,
  "https_port": 0,
  "log_file": "<cache>/<name>_vm_log.log",
  "debug": false,
  "argo_branch": "main",
  "argo_sp_env": "main",
  "release": "latest",  // "auto", "latest", "build-259"(e.g)
  "mode": "auto",  // "auto", "tdx", "sev-snp", "untrusted"
  "guest-cid": 3,
  "build_dir": ""  // "empty" or path to local relese artifacts dir
}
